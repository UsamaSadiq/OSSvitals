{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["github_org", "apps"],
  "properties": {
    "github_org": {"type": "string"},
    "site_url": {"type": "string"},
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["repo", "class"],
        "properties": {
          "repo": {"type": "string"},
          "class": {"enum": ["fork", "original", "dependency"]},
          "owner": {"description": "GitHub owner of this repo when it is not github_org.", "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"},
          "upstream": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "upstream_branch": {"type": "string"},
          "production_branch": {"type": "string"},
          "fork_release_tag": {"type": "string", "format": "regex"},
          "release_tag": {"type": "string", "format": "regex"},
          "licence": {"type": "string"},
          "licence_note": {"type": "string"},
          "mcp_server": {"type": "string"},
          "sso": {"type": "string"},
          "e2e": {"type": "string"},
          "runbook_url": {"type": "string"},
          "purpose": {"type": "string"},
          "what_we_changed": {"type": "string"},
          "pin": {"description": "The tag, branch or commit the production build installs.", "type": "string", "minLength": 1},
          "pin_note": {"description": "Where the pin comes from, shown beside it.", "type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"class": {"const": "fork"}}},
            "then": {"required": ["upstream", "upstream_branch"]}
          },
          {
            "if": {"properties": {"class": {"const": "dependency"}}},
            "then": {
              "required": ["owner", "pin"],
              "not": {"anyOf": [{"required": ["upstream"]}, {"required": ["upstream_branch"]}, {"required": ["production_branch"]}, {"required": ["fork_release_tag"]}]}
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
