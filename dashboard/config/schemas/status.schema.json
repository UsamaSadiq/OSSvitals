{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "branches", "statuses"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "branches": {
      "type": "object",
      "required": ["production", "staging"],
      "properties": {
        "production": {"type": "string"},
        "staging": {"type": "string"}
      },
      "additionalProperties": false
    },
    "statuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "label"],
        "properties": {
          "key": {"type": "string"},
          "label": {"type": "string"},
          "min_behind": {"type": "integer", "minimum": 0},
          "min_days_since_upstream_merge": {"type": "integer", "minimum": 0},
          "on_advisory_newer_than_release": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "freshness": {
      "type": "object",
      "properties": {
        "stale_threshold_hours": {"type": "integer", "minimum": 1},
        "critically_stale_threshold_hours": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
