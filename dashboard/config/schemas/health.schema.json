{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A health tenant's settings after its health.yaml is merged over _kinds/health/defaults.yaml.",
  "type": "object",
  "required": [
    "version",
    "pages",
    "collectors",
    "page_collectors"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/"
      },
      "contains": {
        "const": "/"
      }
    },
    "collectors": {
      "type": "object",
      "required": [
        "upgrade_jobs",
        "waves",
        "campaigns",
        "redundant_prs",
        "catalog",
        "fix_prs",
        "support_windows",
        "modularization",
        "platform_trends",
        "extension_points"
      ],
      "properties": {
        "upgrade_jobs": {
          "type": "boolean"
        },
        "waves": {
          "type": "boolean"
        },
        "campaigns": {
          "type": "boolean"
        },
        "redundant_prs": {
          "type": "boolean"
        },
        "catalog": {
          "type": "boolean"
        },
        "fix_prs": {
          "type": "boolean"
        },
        "support_windows": {
          "type": "boolean"
        },
        "modularization": {
          "type": "boolean"
        },
        "platform_trends": {
          "type": "boolean"
        },
        "extension_points": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "page_collectors": {
      "type": "object",
      "propertyNames": {
        "pattern": "^/"
      },
      "additionalProperties": {
        "enum": [
          "upgrade_jobs",
          "waves",
          "campaigns",
          "redundant_prs",
          "catalog",
          "fix_prs",
          "support_windows",
          "modularization"
        ]
      }
    }
  },
  "additionalProperties": false
}
