{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A health tenant's settings after its health.yaml is merged over _kinds/health/defaults.yaml.",
  "type": "object",
  "required": ["version", "pages"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "pages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"},
      "contains": {"const": "/"}
    }
  },
  "additionalProperties": false
}
