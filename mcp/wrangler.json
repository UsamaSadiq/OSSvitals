{
  "name": "ossvitals-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "mcp.ossvitals.org", "custom_domain": true }],
  "alias": { "zod": "./node_modules/zod" },
  "vars": { "VIEWS_BASE": "https://{org}.ossvitals.org/data/{org}/views" },
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }
  ]
}
